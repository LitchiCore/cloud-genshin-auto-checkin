# 网站生成邀请链接时使用的公开地址
CLOUD_GENSHIN_PUBLIC_URL=https://example.com

# 可选：不允许从后台删除的账号名
CLOUD_GENSHIN_PROTECTED_ACCOUNT=admin

# IPv6 监控初始基准；首次成功更新后会写入 web/ipv6_expected.json 持久化
CLOUD_GENSHIN_EXPECTED_IPV6=2001:db8::1

# 安装到其他目录时可覆盖 helper 的默认路径
CLOUD_GENSHIN_HOME=/opt/cloud-genshin

# 可选：自定义 Nginx 直连站点位置
CLOUD_GENSHIN_NGINX_DIRECT_SITE=/etc/nginx/sites-available/cloud-genshin-direct
CLOUD_GENSHIN_NGINX_DIRECT_ENABLED=/etc/nginx/sites-enabled/cloud-genshin-direct
CLOUD_GENSHIN_ACME_WEBROOT=/var/lib/letsencrypt
