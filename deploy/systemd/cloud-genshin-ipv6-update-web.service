[Unit]
Description=Cloud Genshin IPv6 Update Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=cloud-genshin

WorkingDirectory=/opt/cloud-genshin

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/usr/bin/python3 /opt/cloud-genshin/web/ipv6_update_web.py

Restart=on-failure
RestartSec=3

# 这个单一服务需要 sudo 固定 helper。
NoNewPrivileges=false

PrivateTmp=true

[Install]
WantedBy=multi-user.target
